 #define OCT_IGNORE 10u
 
 namespace bssn
@@ -258,12 +265,22 @@ namespace bssn
 
         // BH considered merged if the distance between punctures are less than the specified value. 
         const double BH_MERGED_SEP_TOL=0.1;
+
+        // create a vector to store the error in the constraint, by *element* (so block)
+        ot::DVector<DendroScalar, unsigned int> constraint_violation_vec_ele;
